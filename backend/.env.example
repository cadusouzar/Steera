# O usuário do banco referenciado aqui precisa ter o privilégio CREATE no banco de dados —
# necessário desde a Fase 1 do isolamento por schema-por-tenant, que roda `CREATE SCHEMA` a cada
# nova empresa registrada. Verificar com:
#   psql "$DATABASE_URL" -c "SELECT has_database_privilege(current_user, current_database(), 'CREATE');"
# Se vier `f`, rodar (autenticado como um usuário com permissão): GRANT CREATE ON DATABASE <nome> TO <usuario>;
#
# Esta URL aponta pro PgBouncer (porta 6432), não direto pro Postgres (5432) — suba o contêiner
# primeiro: docker compose -f docker-compose.pgbouncer.yml up -d. Ver backend/pgbouncer/ pro
# porquê (mantém o custo de conexões baixo à medida que mais empresas ficam ativas).
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:6432/quickflow?schema=public&pgbouncer=true"
PORT=3001
JWT_ACCESS_SECRET=troque-por-um-valor-aleatorio-longo-em-producao
FRONTEND_ORIGIN=http://localhost:5173

# Tamanho do cache de PrismaClient por tenant (TenantPrismaClientRegistry) — uma entrada por
# empresa ATIVA agora, não por empresa cadastrada. O default de 50 já é confortavelmente maior que
# qualquer nível de concorrência testado com sucesso de verdade neste ambiente (medido em
# 2026-09-16, backend/test/tenant-connection-stress.e2e-spec.ts): 30 empresas novas registradas
# concorrentemente, 5 requisições simultâneas cada (150 requisições reais ao mesmo tempo), sem
# nenhuma falha — o cache nunca chegou perto de precisar expulsar nada nesse nível. Subir o teste
# além disso (até 250 requisições concorrentes em várias distribuições de empresas/requisições)
# encontrou um teto de concorrência REAL, mas que não tem relação com este valor — reproduzido de
# forma idêntica com o cache configurado bem abaixo de 50 (inclusive com 1 única empresa), e mesmo
# sem PgBouncer no meio (indo direto no Postgres). É uma limitação do ambiente de teste local
# (Windows + laço de eventos único do Node processando centenas de conexões de loopback
# simultâneas na mesma rodada de teste), não do roteamento por tenant — toda falha observada foi um
# erro limpo (nunca dado de uma empresa vazando pra outra). Ajustar este valor conforme o volume
# real de empresas ativas ao mesmo tempo em produção; não há evidência de que 50 seja baixo demais.
TENANT_CLIENT_CACHE_MAX_SIZE=50

# E-mail transacional (Resend). Chave: painel do Resend → API Keys (Sending access, domínio steera.com.br).
# Nunca commitar a chave real. Sem chave em dev, os e-mails só aparecem no log do backend.
RESEND_API_KEY=
MAIL_FROM="Steera <no-reply@steera.com.br>"
# Base dos links enviados por e-mail (confirmar e-mail, convite, redefinir senha).
FRONTEND_URL=http://localhost:5173
